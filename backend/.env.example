APP_NAME=Cyanea API
APP_ENV=development
API_V1_PREFIX=/api/v1
API_BASE_URL=http://127.0.0.1:8000/api/v1
TERMS_VERSION=2026-10-03
DATABASE_URL=postgresql+psycopg://usuario:password@127.0.0.1:5432/cyanea
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006

SECRET_KEY=cambia-esto-en-produccion-usa-un-secreto-real
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

GOOGLE_AUTH_ENABLED=false
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_MAPS_API_KEY=

FACEBOOK_AUTH_ENABLED=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

MAIL_ENABLED=false
MAIL_PROVIDER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM_EMAIL=no-reply@cyanea.local
MAIL_FROM_NAME=Cyanea
MAIL_REPLY_TO=
MAIL_FRONTEND_BASE_URL=http://127.0.0.1:8081

BREVO_API_KEY=

PUSH_ENABLED=true
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=
ACTIVITY_REMINDERS_ENABLED=true
ACTIVITY_REMINDER_MINUTES_BEFORE=60
ACTIVITY_REMINDER_SCAN_INTERVAL_SECONDS=60

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=trip-documents

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
AI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
AI_COVER_MOCK=false

AI_RECEIPT_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_VERIFY_SSL=true
AI_RECEIPT_MODEL=gemini-3.8-flash
AI_RECEIPT_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_RECEIPT_TIMEOUT_SECONDS=12

AI_ASSISTANT_ENABLED=true
AI_ASSISTANT_PROVIDER=gemini
AI_ASSISTANT_MODEL=
AI_ASSISTANT_FALLBACK_MODEL=
AI_ASSISTANT_TIMEOUT_SECONDS=20


# Monitoreo de consumo de IA (US 114): precios de referencia en USD
# Gemini (tier pago Standard): https://ai.google.dev/gemini-api/docs/pricing
# gemini-3.8-flash: 0.75 / 3.75 hasta el 31/12/2026; desde el 1/1/2027 pasa a 1.50 / 7.50
AI_COST_INPUT_USD_PER_MILLION_TOKENS=0.75
AI_COST_OUTPUT_USD_PER_MILLION_TOKENS=3.75
# gemini-3.5-flash-lite
AI_COST_LITE_INPUT_USD_PER_MILLION_TOKENS=0.30
AI_COST_LITE_OUTPUT_USD_PER_MILLION_TOKENS=2.50
# Cloudflare Workers AI flux-1-schnell: https://developers.cloudflare.com/workers-ai/platform/pricing/
# 1024x1024 = 4 tiles x 0.0000528 + 4 steps x 0.0001056
AI_COST_IMAGE_USD=0.00063

# Suscripcion Pro con Mercado Pago (US 116 y US 117)
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de Webhooks: sin ella las notificaciones se rechazan con 503
MERCADOPAGO_WEBHOOK_SECRET=
# Solo para desarrollo local: acepta notificaciones sin firma si no hay clave
MERCADOPAGO_WEBHOOK_ALLOW_UNSIGNED=false
MERCADOPAGO_BACK_URL=
MERCADOPAGO_APP_RETURN_URL=cyanea://suscripcion/retorno
MERCADOPAGO_TEST_PAYER_EMAIL=
# Dias que una renovacion rechazada puede quedar pendiente de pago antes de vencer
SUBSCRIPTION_PENDING_PAYMENT_DAYS=3
