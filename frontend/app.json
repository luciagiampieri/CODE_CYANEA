{
  "expo": {
    "name": "Cyanea",
    "slug": "cyanea",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cyanea_Logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ticigaticasteam.cyanea",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ticigaticasteam.cyanea",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1e3e7b"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "name": "Cyanea",
      "favicon": "./assets/cyanea_Logo.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      "expo-font",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyC7CYPXZxfbrReuj82aWaTQ0oxrm8E5LAE"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos acceso a tus fotos para elegir la portada del viaje."
        }
      ],
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "0dddd612-ef66-4470-9a77-ce206f823efd"
      }
    },
    "scheme": "cyanea",
    "owner": "lcorrea87s-team"
  }
}
