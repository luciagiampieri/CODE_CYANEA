{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.17.1",
    "@react-navigation/native": "^7.3.0",
    "@react-navigation/native-stack": "^7.17.1",
    "expo": "54",
    "expo-auth-session": "~7.0.11",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-fetch": "^0.0.0",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-asset": "~12.0.13",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "jest-expo": "~54.0.18",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start",
    "android": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --android",
    "ios": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --ios",
    "web": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --web --port 8081",
    "web:clear": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --web --port 8081 --clear",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:slow": "jest --runInBand"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "cross-env": "^10.1.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/tests/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 30
      }
    }
  }
}
