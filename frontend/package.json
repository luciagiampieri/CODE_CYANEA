{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.17.1",
    "@react-navigation/native": "^7.3.0",
    "@react-navigation/native-stack": "^7.17.1",
    "date-fns": "^4.4.0",
    "expo": "^58.0.21",
    "expo-asset": "~58.0.19",
    "expo-auth-session": "~58.0.16",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-document-picker": "~58.0.4",
    "expo-fetch": "^0.0.0",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "jest-expo": "~58.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-calendar-picker": "^8.0.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "scripts": {
    "start": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start",
    "android": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --android",
    "ios": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --ios",
    "web": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --web --port 8081",
    "web:clear": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --web --port 8081 --clear",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:slow": "jest --runInBand"
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/tests/**",
      "!src/**/*.native.js",
      "!src/theme/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 30
      }
    }
  }
}
