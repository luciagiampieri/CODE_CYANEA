@startuml
!pragma layout smetana
hide circle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classBackgroundColor #F1F8FA
skinparam classBorderColor #286779
skinparam ArrowColor #4B6370
skinparam nodesep 55
skinparam ranksep 75
title Cyanea · Módulo 5 · Votaciones\nDER resumido · atributos seleccionados

entity "Votaciones" as Votaciones {
  {field} * IdVotacion : BIGINT <<PK>>
  {field} * IdViaje : BIGINT <<FK>>
  {field} * Titulo : VARCHAR(150)
  {field} * Tipo : tipo_votacion_enum
  {field} * FechaCierre : TIMESTAMPTZ
  {field} * IdCreador : BIGINT <<FK>>
  {field} * EsDeSugerencias : BOOLEAN
  {field}   IdDiaCronograma : INTEGER <<FK>>
}

entity "Propuestas" as Propuestas {
  {field} * IdPropuesta : BIGINT <<PK>>
  {field} * IdVotacion : BIGINT <<FK>>
  {field} * Texto : VARCHAR(255)
  {field}   IdSugerenciaActividad : INTEGER <<FK>>
}

entity "Votos" as Votos {
  {field} * IdVoto : BIGINT <<PK>>
  {field} * IdUsuario : BIGINT <<FK, UQ1>>
  {field} * IdVotacion : BIGINT <<FK, UQ1>>
  {field} * IdPropuesta : BIGINT <<FK, UQ1>>
  {field} * FechaVoto : TIMESTAMPTZ
}

entity "DiasCronogramas (módulo 3)" as DiasCronogramas #EEEEEE {
  {field} * IdDiaCronograma : INTEGER <<PK>>
}

entity "SugerenciasActividades (módulo 4)" as SugerenciasActividades #EEEEEE {
  {field} * IdSugerenciaActividad : INTEGER <<PK>>
}

entity "Usuarios (módulo 1)" as Usuarios #EEEEEE {
  {field} * IdUsuario : INTEGER <<PK>>
}

entity "Viajes (módulo 2)" as Viajes #EEEEEE {
  {field} * IdViaje : INTEGER <<PK>>
}

DiasCronogramas |o--o{ Votaciones : DiaCronograma
Usuarios ||--o{ Votaciones : crea
Viajes ||--o{ Votaciones : Viaje
SugerenciasActividades |o--o{ Propuestas : sugerencia origen
Votaciones ||--o{ Propuestas : votación
Propuestas ||--o{ Votos : selecciona
Usuarios ||--o{ Votos : vota
Votaciones ||--o{ Votos : votación
legend bottom
  Azul: tablas propias · Gris: referencias externas (solo PK)
  PK: clave primaria · FK: clave foránea · UQ: unicidad individual
  UQ1: unicidad compuesta dentro de la tabla
  UP1/UP2: índice UNIQUE parcial; consultar columnas y condición en el diccionario
  Los índices parciales no implican unicidad incondicional de una FK.
  * Campo NOT NULL · Sin *: admite NULL
  TIMESTAMPTZ: TIMESTAMP WITH TIME ZONE · TIME: TIME WITHOUT TIME ZONE
  Las relaciones solo representan FK físicas, no identificadores dentro de JSON o texto.
  Atributos restantes: consultar el DER físico y el diccionario.
endlegend
@enduml
