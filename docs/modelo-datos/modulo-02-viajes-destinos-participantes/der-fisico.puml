@startuml
!pragma layout smetana
hide circle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classBackgroundColor #F1F8FA
skinparam classBorderColor #286779
skinparam ArrowColor #4B6370
skinparam nodesep 60
skinparam ranksep 85
title Cyanea · Módulo 2 · Viajes, destinos y participantes\nDER físico completo

entity "Viajes" as Viajes {
  {field} * IdViaje : INTEGER <<PK>>
  {field} * Titulo : VARCHAR(150)
  {field}   Descripcion : VARCHAR
  {field} * FechaInicio : DATE
  {field} * FechaFin : DATE
  {field} * IdEstadoViaje : INTEGER <<FK>>
  {field} * Moneda : VARCHAR(3) <<FK>>
  {field} * IdAdministrador : INTEGER <<FK>>
  {field} * FechaCreacion : TIMESTAMPTZ
  {field} * FechaActualizacion : TIMESTAMPTZ
  {field}   GooglePlaceIdPortada : VARCHAR(255)
  {field}   UrlPortadaPersonalizada : VARCHAR(500)
}

entity "Destinos" as Destinos {
  {field} * IdDestino : INTEGER <<PK>>
  {field} * Nombre : VARCHAR(200)
  {field} * Pais : VARCHAR(100)
  {field}   Lat : DOUBLE PRECISION
  {field}   Lng : DOUBLE PRECISION
  {field}   ProvinciaEstado : VARCHAR(150)
}

entity "DestinosViajes" as DestinosViajes {
  {field} * IdViaje : INTEGER <<PK, FK>>
  {field} * IdDestino : INTEGER <<PK, FK>>
  {field} * Orden : INTEGER
  {field}   Noches : INTEGER
  {field} * NochesEnViaje : INTEGER
}

entity "EstadosViajes" as EstadosViajes {
  {field} * IdEstadoViaje : INTEGER <<PK>>
  {field} * Nombre : VARCHAR(30)
  {field}   Descripcion : VARCHAR(200)
  {field} * Activo : BOOLEAN
}

entity "ParticipantesViajes" as ParticipantesViajes {
  {field} * IdParticipanteViaje : INTEGER <<PK>>
  {field} * IdViaje : INTEGER <<FK, UQ1>>
  {field} * IdUsuario : INTEGER <<FK, UQ1>>
  {field} * IdRolParticipante : INTEGER <<FK>>
  {field} * IdEstadoParticipacion : INTEGER <<FK>>
  {field} * FechaInvitacion : TIMESTAMPTZ
  {field}   FechaRespuesta : TIMESTAMPTZ
  {field}   FechaIncorporacion : TIMESTAMPTZ
  {field}   InvitadoPor : INTEGER <<FK>>
  {field}   FechaSalida : TIMESTAMPTZ
  {field}   IdAdministradorAlMomentoDeSalida : INTEGER <<FK>>
  {field} * VencidaPorFinViaje : BOOLEAN
}

entity "RolesParticipantes" as RolesParticipantes {
  {field} * IdRolParticipante : INTEGER <<PK>>
  {field} * Nombre : VARCHAR(30)
  {field}   Descripcion : VARCHAR(200)
  {field} * Activo : BOOLEAN
}

entity "EstadosParticipaciones" as EstadosParticipaciones {
  {field} * IdEstadoParticipacion : INTEGER <<PK>>
  {field} * Nombre : VARCHAR(30)
  {field}   Descripcion : VARCHAR(200)
  {field} * Activo : BOOLEAN
}

entity "InvitacionesViajes" as InvitacionesViajes {
  {field} * IdInvitacionViaje : INTEGER <<PK>>
  {field} * IdViaje : INTEGER <<FK, UQ1>>
  {field} * EmailInvitado : VARCHAR(255) <<UQ1>>
  {field}   NombreInvitado : VARCHAR(150)
  {field} * TokenInvitacion : VARCHAR(120) <<UQ>>
  {field} * FechaInvitacion : TIMESTAMPTZ
  {field} * FechaVencimiento : TIMESTAMPTZ
  {field}   FechaAceptacion : TIMESTAMPTZ
  {field} * IdEstadoInvitacion : INTEGER <<FK>>
  {field} * InvitadoPor : INTEGER <<FK>>
  {field}   IdUsuarioRegistrado : INTEGER <<FK>>
  {field} * VencidaPorFinViaje : BOOLEAN
}

entity "EstadosInvitaciones" as EstadosInvitaciones {
  {field} * IdEstadoInvitacion : INTEGER <<PK>>
  {field} * Nombre : VARCHAR(30) <<UQ>>
  {field}   Descripcion : VARCHAR(200)
  {field} * Activo : BOOLEAN
}

entity "EnlacesInvitacionViajes" as EnlacesInvitacionViajes {
  {field} * IdEnlaceInvitacionViaje : INTEGER <<PK>>
  {field} * IdViaje : INTEGER <<FK, UQ>>
  {field} * TokenEnlace : VARCHAR(120) <<UQ>>
  {field} * IdUsuarioCreador : INTEGER <<FK>>
  {field} * FechaCreacion : TIMESTAMPTZ
  {field} * FechaVencimiento : TIMESTAMPTZ
  {field}   FechaRevocacion : TIMESTAMPTZ
}

entity "Usuarios (módulo 1)" as Usuarios #EEEEEE {
  {field} * IdUsuario : INTEGER <<PK>>
}
entity "Monedas (módulo 6)" as Monedas #EEEEEE {
  {field} * Codigo : VARCHAR(3) <<PK>>
}
EstadosViajes ||--o{ Viajes : estado
Monedas ||--o{ Viajes : moneda base
Usuarios ||--o{ Viajes : administra
Destinos ||--o{ DestinosViajes : destino
Viajes ||--o{ DestinosViajes : recorrido
EstadosParticipaciones ||--o{ ParticipantesViajes : estado
RolesParticipantes ||--o{ ParticipantesViajes : rol
Usuarios |o--o{ ParticipantesViajes : admin. al salir
Usuarios ||--o{ ParticipantesViajes : integrante
Usuarios |o--o{ ParticipantesViajes : invita integrante
Viajes ||--o{ ParticipantesViajes : grupo
EstadosInvitaciones ||--o{ InvitacionesViajes : estado
Usuarios |o--o{ InvitacionesViajes : cuenta vinculada
Usuarios ||--o{ InvitacionesViajes : invita por correo
Viajes ||--o{ InvitacionesViajes : invitacion personal
Usuarios ||--o{ EnlacesInvitacionViajes : crea enlace
Viajes ||--o| EnlacesInvitacionViajes : enlace compartible
legend bottom
  Azul: tablas propias · Gris: referencias externas (solo PK)
  PK: clave primaria · FK: clave foránea · UQ: unicidad individual
  UQ1: unicidad compuesta dentro de cada tabla; no implica unicidad de cada campo
  DestinosViajes: PK (IdViaje, IdDestino)
  ParticipantesViajes: UQ1 (IdViaje, IdUsuario)
  InvitacionesViajes: UQ1 (IdViaje, EmailInvitado)
  * Campo NOT NULL · Sin *: admite NULL
  TIMESTAMPTZ: TIMESTAMP WITH TIME ZONE
  Varias líneas desde Usuarios identifican FK diferentes.
endlegend
@enduml
