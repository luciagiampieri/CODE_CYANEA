@startuml
!pragma layout smetana
hide circle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classBackgroundColor #F1F8FA
skinparam classBorderColor #286779
skinparam ArrowColor #4B6370
skinparam nodesep 55
skinparam ranksep 75
title Cyanea · Módulo 8 · Tareas y checklist\nDER resumido · atributos seleccionados

entity "Checklists" as Checklists {
  {field} * IdChecklist : INTEGER <<PK>>
  {field} * IdViaje : INTEGER <<FK>>
  {field} * IdUsuarioCreador : INTEGER <<FK>>
  {field} * Nombre : VARCHAR(150)
  {field} * IdCategoriaChecklist : BIGINT <<FK>>
  {field} * Completada : BOOLEAN
  {field}   IdActividad : INTEGER <<FK>>
  {field}   IdUsuarioCompletada : INTEGER <<FK>>
  {field} * EsPrivada : BOOLEAN
}

entity "CategoriasChecklist" as CategoriasChecklist {
  {field} * IdCategoriaChecklist : BIGINT <<PK>>
  {field} * Nombre : VARCHAR(50) <<UQ>>
}

entity "ResponsablesChecklist" as ResponsablesChecklist {
  {field} * IdChecklist : INTEGER <<PK, FK>>
  {field} * IdUsuario : INTEGER <<PK, FK>>
}

entity "DocumentosChecklists" as DocumentosChecklists {
  {field} * IdChecklist : INTEGER <<PK, FK>>
  {field} * IdDocumento : INTEGER <<PK, FK>>
}

entity "ActividadesItinerario (módulo 3)" as ActividadesItinerario #EEEEEE {
  {field} * IdActividad : INTEGER <<PK>>
}

entity "DocumentosViajes (módulo 7)" as DocumentosViajes #EEEEEE {
  {field} * IdDocumento : INTEGER <<PK>>
}

entity "Usuarios (módulo 1)" as Usuarios #EEEEEE {
  {field} * IdUsuario : INTEGER <<PK>>
}

entity "Viajes (módulo 2)" as Viajes #EEEEEE {
  {field} * IdViaje : INTEGER <<PK>>
}

ActividadesItinerario |o--o{ Checklists : actividad vinculada
CategoriasChecklist ||--o{ Checklists : categoría
Usuarios ||--o{ Checklists : creado por
Usuarios |o--o{ Checklists : hecha por
Viajes ||--o{ Checklists : viaje
Checklists ||--o{ ResponsablesChecklist : tarea
Usuarios ||--o{ ResponsablesChecklist : responsable
Checklists ||--o{ DocumentosChecklists : tarea
DocumentosViajes ||--o{ DocumentosChecklists : documento adjunto
legend bottom
  Azul: tablas propias · Gris: referencias externas (solo PK)
  PK: clave primaria · FK: clave foránea · UQ: unicidad individual
  UQ1: unicidad compuesta dentro de la tabla
  UP1/UP2: índice UNIQUE parcial; consultar columnas y condición en el diccionario
  Los índices parciales no implican unicidad incondicional de una FK.
  * Campo NOT NULL · Sin *: admite NULL
  TIMESTAMPTZ: TIMESTAMP WITH TIME ZONE · TIME: TIME WITHOUT TIME ZONE
  Las relaciones solo representan FK físicas, no identificadores dentro de JSON o texto.
  Atributos restantes: consultar el DER físico y el diccionario.
endlegend
@enduml
